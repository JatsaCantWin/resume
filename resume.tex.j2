%-------------------------
% Rover Resume - Star Template
% Link: https://github.com/subidit/rover-resume
%
% CUSTOM COMMANDS \aux{} and \rside{} for part formatting
% eg. \subsection{Company Name \aux{Designation} \rside{Duration}}
% Double lined titles with \subsection{} and \subsubsection{}
% \linkicon gives external link icon
%-------------------------

\documentclass[11pt]{article}

\usepackage[sfdefault,semibold,lf]{FiraSans}
\usepackage[a4paper,margin=1in]{geometry}

\usepackage{xcolor}
\definecolor{accent}{HTML}{141E61}

\setcounter{secnumdepth}{0}
\pdfgentounicode=1

%====== LIST FORMATTING ======

\usepackage{enumitem}

\setlist[itemize]{nosep, left=0pt .. 1.5em}
\setlist[enumerate]{left=0pt..1.5em}
\setlist[description]{itemsep=0pt}

%====== TITLE FORMATTING ======

\usepackage{xhfill}
\usepackage{soul}

\newcommand{\midrule}[1]{
  \leavevmode
  \xrfill[.5ex]{1pt}[accent]\so{#1}\xrfill[.5ex]{1pt}[accent]
}

\usepackage{titlesec}

\titlespacing{\section}{0pt}{*4}{*1}
\titlespacing{\subsection}{0pt}{*3}{*0}
\titlespacing{\subsubsection}{0pt}{*0}{*0}

\titleformat{\section}{\large\bfseries\uppercase}{}{}{\midrule}
\titleformat*{\subsection}{\large\bfseries\scshape}

%====== CUSTOM COMMANDS ======

\newcommand{\aux}[1]{
  $|$ \space {\normalfont\itshape #1}%
}

\newcommand{\rside}[1]{
  \hfill {\normalfont\color{accent} #1}%
}

%====== FOOTER ======

\usepackage{lastpage}
\usepackage{fancyhdr}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

\fancyfoot[C]{%
  \ifnum\value{page}>1
    \small\color{gray} << personal.name >> -- Page \thepage\ of \pageref*{LastPage}%
  \else
    \ifnum\getpagerefnumber{LastPage}>1
      \small\color{gray} << personal.name >> -- Page \thepage\ of \pageref*{LastPage}%
    \fi
  \fi
}

%====== PACKAGES ======

\usepackage{fontawesome5}
\usepackage{multicol}
\usepackage[bookmarks=false,hidelinks]{hyperref}

%====== DOCUMENT STARTS HERE ======

\begin{document}

%====== BANNER ======

\begin{center}
  {
    \fontsize{36}{12}
    \fontseries{heavy}\selectfont
    \color{accent}
    << personal.name >>
  } \\ \medskip

  {\color{gray}{\faHome}} << personal.address >> \quad
  \href{tel:<< personal.phone_href >>}{
    {\color{gray}{\faPhone}} << personal.phone >>
  } \quad
  \href{mailto:<< personal.email >>}{
    {\color{gray}{\faEnvelope}} << personal.email >>
  } \quad
  \href{<< personal.linkedin.url >>}{
    {\color{gray}{\faLinkedin}} << personal.linkedin.username >>
  }
\end{center}

%====== BANNER END ======

%====== EDUCATION ======

<% if education %>

\section{Education}

<% for entry in education %>

\subsection{
<< entry.institution >>
\aux{ << entry.degree >> }
\rside{ << entry.start >> -- << entry.end >> }
}

<% endfor %>

<% endif %>

%====== EXPERIENCE ======

<% if experience %>

\section{Experience}

<% for entry in experience %>

\subsection{
<< entry.company >>
\rside{ << entry.location >> }
}

\subsubsection{
<< entry.role >>
\rside{ << entry.start >> -- << entry.end >> }
}

\begin{itemize}

<% for bullet in entry.bullets %>
\item << bullet.text >>
<% endfor %>

\end{itemize}

<% endfor %>

<% endif %>

%====== SKILLS ======

<% if skills.technical or skills.language or skills.interests %>

\section{Skills}

\begin{description}

<% if skills.technical %>
\item[Technical]
<% for skill in skills.technical %>
<< skill.name >><% if not loop.last %>, <% endif %>
<% endfor %>
<% endif %>

<% if skills.language %>
\item[Language]
<% for language in skills.language %>
<< language.name >> (<< language.level >>)<% if not loop.last %>, <% endif %>
<% endfor %>
<% endif %>

<% if skills.interests %>
\item[Interests]
<% for interest in skills.interests %>
<< interest.name >><% if not loop.last %>, <% endif %>
<% endfor %>
<% endif %>

\end{description}

<% endif %>

%====== CERTIFICATIONS ======

<% if certifications %>

\section{Certifications}

\begin{enumerate}[label=\null, left=0pt..0pt, itemsep=0pt]

<% for cert in certifications %>

\item
\subsection{
<< cert.name >>
\rside{ << cert.date >> }
}

<% endfor %>

\end{enumerate}

<% endif %>

%====== PUBLICATIONS ======

<% if publications %>

\section{Publications}

\begin{enumerate}

<% for pub in publications %>

\item
<< pub.authors | join(', ') >> (<< pub.year >>).
<< pub.title >>.
\emph{
<< pub.venue >>,
pp. << pub.pages >>,
<< pub.date >>
}
<% if pub.doi %>
\href{ << pub.doi.url >> }{[<< pub.doi.label >>]}.
<% endif %>

<% endfor %>

\end{enumerate}

<% endif %>

%====== AWARDS ======

<% if awards %>

\section{Awards}

\begin{description}

<% for award in awards %>

\item
\subsection{
<< award.name >>
<% if award.date %>
\rside{ << award.date >> }
<% endif %>
}

<% if award.description %>
<< award.description >>
<% endif %>

<% endfor %>

\end{description}

<% endif %>

%====== PROJECTS ======

<% if projects %>

\section{Projects}

<% for project in projects %>

\subsection{ << project.name >> }

\begin{itemize}

<% for bullet in project.bullets %>
\item << bullet.text >>
<% endfor %>

\end{itemize}

<% endfor %>

<% endif %>

\end{document}
